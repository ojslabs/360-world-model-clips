# Local use: copy FAL_KEY to .env.local, or export it in the server environment.
# Docker/shared host: copy this file to .env and fill the three required values.
# Keep the resulting file private. Never commit credentials.
FAL_KEY=
# Required for a shared host, at least 16 characters.
DEMO_PASSWORD=
# Exact browser origin, e.g. https://clips.example.com
# http://localhost:8476 is allowed for a protected local Docker smoke test.
PUBLIC_ORIGIN=
