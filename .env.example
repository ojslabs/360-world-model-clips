# Connect your own Fal key in the app's blank "Your Fal account" field.
# Docker/shared host: copy this file to .env and fill the host settings below.
# Keep the resulting file private. Never commit credentials.
# Optional: enables Reactor X2 edits of completed highlights. Server-side only.
REACTOR_API_KEY=
# Required for a shared host, at least 16 characters.
DEMO_PASSWORD=
# Exact browser origin, e.g. https://clips.example.com
# http://localhost:8476 is allowed for a protected local Docker smoke test.
PUBLIC_ORIGIN=
